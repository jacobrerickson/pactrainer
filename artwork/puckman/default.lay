<?xml version="1.0"?>
<!--
	Pattern Trainer face-state overlay.

	Displays a coloured face indicator driven by the plugin's "pactrainer_face" output.
	  state 0 = ACE (green)
	  state 1 = OK  (yellow)
	  state 2 = BAD (red)
	  state 3 = FAIL (grey)

	Uses disk primitives so the layout works with no external image assets. Drop in
	ace.png / ok.png / bad.png / fail.png alongside this file and replace the <disk>
	items with <image state="N" file="ace.png"/> etc. to use custom artwork.

	Install: copy this folder to your MAME artworkpath as "pacman/" (or zip it as
	pacman.zip). An identical copy is bundled as "puckman/" so the layout works with
	both ROM names. The plugin sets the face output every frame — if the artwork is
	not installed, the plugin still runs normally.
-->
<mamelayout version="2">

	<element name="face" defstate="0">
		<disk state="0"><color red="0.15" green="0.85" blue="0.15"/></disk>
		<disk state="1"><color red="0.95" green="0.85" blue="0.10"/></disk>
		<disk state="2"><color red="0.90" green="0.15" blue="0.15"/></disk>
		<disk state="3"><color red="0.40" green="0.40" blue="0.40"/></disk>
	</element>

	<view name="Trainer">
		<screen index="0">
			<bounds x="72" y="0" width="224" height="288"/>
		</screen>

		<!-- Live face state driven from the plugin -->
		<element ref="face" name="pactrainer_face">
			<bounds x="8" y="16" width="56" height="56"/>
		</element>
	</view>

</mamelayout>
